#include <iostream>
using namespace std;

int main()
{
    int n, amount;

    cout << "Enter number of coin denominations: ";
    cin >> n;

    int coins[20];

    cout << "Enter coin denominations: ";
    for (int i = 0; i < n; i++)
    {
        cin >> coins[i];
    }

    cout << "Enter amount: ";
    cin >> amount;

    // dp[i] = minimum number of coins required to make amount i
    int dp[1000];

    dp[0] = 0;

    // Initialize all values to a large number
    for (int i = 1; i <= amount; i++)
    {
        dp[i] = 999999;
    }

    // Dynamic Programming
    for (int i = 1; i <= amount; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (coins[j] <= i)
            {
                dp[i] = min(dp[i], dp[i - coins[j]] + 1);
            }
        }
    }

    if (dp[amount] == 999999)
    {
        cout << "Change cannot be made." << endl;
    }
    else
    {
        cout << "Minimum number of coins required = "
             << dp[amount] << endl;
    }

    return 0;
}
